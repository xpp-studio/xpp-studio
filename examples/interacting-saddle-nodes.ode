# Interacting saddle-nodes
# (Ashwin, Postlethwaite and Sieber Nonlinearity 2026 DOI:10.1088/1361-6544/ae788a)
# 
init x=4.420941241 y=-3.344263964

# Params
par mu=-2.7 gamma=0.6
par alpha=3.1 beta=-1.3

# transform to lambda
lambda=mu + gamma*(gamma+alpha^2-beta^2)/(alpha+beta)^2

# Equations
x'=x^2-lambda+2*alpha*y-gamma
y'=y^2-lambda+2*beta*x+gamma

# plot to vector field
@ xplot=x, yplot=y
@ maxstor=10000
# auto defaults
@ epsu=0.000001, epss=0.000001
# Settings written by XPP Studio, 2026-11-03 15:49
@ meth=dormprince, total=10, dt=0.01, toler=0.000001, bound=10
@ xp=x, yp=y, xlo=-2.17823, xhi=4.90982, ylo=-3.67579, yhi=1.13119
@ ds=0.01, dsmin=0.0001, dsmax=0.1, nmax=3000, parmin=-50, parmax=50
done






