# Ashwin, Postlethwaite and Sieber SIADS 2026
# hilltop unfolding
# 
init x=0.07 y=0.05

# Params
par alpha=1 beta=1
par lambda=0.2 gamma=0

# from G&S vol I
x'=x^2-lambda+2*alpha*y-gamma
y'=y^2-lambda+2*beta*x+gamma

# plot to vector field
@ dt=0.01, total=10, xplot=x, yplot=y
@ xlo=-2.0,ylo=-2.0,xhi=2.0,yhi=2.0, bound=10, maxstor=10000
# auto defaults
@ ds=0.01,dsmin=0.0001,dsmax=0.1
@ epsu=0.000001,epss=0.000001
@ parmin=-6.4,parmax=6.4
@ method=rk4
done
